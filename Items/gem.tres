[sub_resource type="GDScript" id="GDScript_hw0jr"]
script/source = "class_name ItemData extends Resource

@export var name : String = \"\"
@export_multiline var description : String = \"\"
@export var texture : Texture2D

@export_category(\"Item Use Effects\")
@export var effects : Array[ ItemEffect ]


func use() -> bool:
	if effects.size() == 0:
		return false
	
	for e in effects:
		if e:
			e.use()
	return true
"

